# Database (use a connection pooler URL in serverless/Vercel to avoid 2–5s connection latency per request)
# e.g. Supabase: port 6543 with ?pgbouncer=true; Neon: use pooler URL
DATABASE_URL="postgresql://user:password@localhost:5432/minihog"

# Server
PORT=3000
NODE_ENV=development

# Attribution
ATTRIBUTION_WINDOW_HOURS=24
